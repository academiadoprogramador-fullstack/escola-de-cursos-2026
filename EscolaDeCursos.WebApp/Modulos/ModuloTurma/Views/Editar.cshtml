@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Turma";
}

@model EditarTurmaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CursoId" class="form-label fw-semibold text-primary text-uppercase small">Curso</label>
        <select asp-for="CursoId" class="form-select" asp-items="@(ViewBag.Cursos as List<SelectListItem>)">
            <option value="">Selecione um curso...</option>
        </select>
        <span asp-validation-for="CursoId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="InstrutorId" class="form-label fw-semibold text-primary text-uppercase small">Instrutor</label>
        <select asp-for="InstrutorId" class="form-select" asp-items="@(ViewBag.Instrutores as List<SelectListItem>)">
            <option value="">Selecione um instrutor...</option>
        </select>
        <span asp-validation-for="InstrutorId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroMaximoAlunos" class="form-label fw-semibold text-primary text-uppercase small">Número Máximo de Alunos</label>
        <input asp-for="NumeroMaximoAlunos" type="number" class="form-control" min="1" max="100">
        <span asp-validation-for="NumeroMaximoAlunos" class="text-danger small fw-semibold"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label asp-for="DataInicio" class="form-label fw-semibold text-primary text-uppercase small">Data de Início</label>
            <input asp-for="DataInicio" type="date" class="form-control">
            <span asp-validation-for="DataInicio" class="text-danger small fw-semibold"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DataTermino" class="form-label fw-semibold text-primary text-uppercase small">Data de Término</label>
            <input asp-for="DataTermino" type="date" class="form-control">
            <span asp-validation-for="DataTermino" class="text-danger small fw-semibold"></span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
