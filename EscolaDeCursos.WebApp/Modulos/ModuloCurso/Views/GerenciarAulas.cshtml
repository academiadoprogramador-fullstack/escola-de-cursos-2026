@{
    Layout = "_Layout";
    ViewBag.Titulo = $"Aulas - {Model.NomeCurso}";
}

@model GerenciarAulasViewModel;

<div class="mb-4">
    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
</div>

@if (TempData["MensagemErro"] is string mensagemErro)
{
    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        @mensagemErro
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">@Model.NomeCurso</h5>
                <dl class="row g-2 mb-0">
                    <dt class="col-5 text-secondary fw-semibold small">Nível</dt>
                    <dd class="col-7 mb-0">@Model.Nivel</dd>

                    <dt class="col-5 text-secondary fw-semibold small">Carga Horária</dt>
                    <dd class="col-7 mb-0">@Model.CargaHoraria h</dd>

                    <dt class="col-5 text-secondary fw-semibold small">Categoria</dt>
                    <dd class="col-7 mb-0">@Model.NomeCategoria</dd>

                    <dt class="col-5 text-secondary fw-semibold small">Aulas</dt>
                    <dd class="col-7 mb-0">@Model.Aulas.Count</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-primary-subtle shadow-sm">
            <div class="card-header bg-transparent border-primary-subtle">
                <h6 class="mb-0 fw-semibold text-primary">Adicionar Aula</h6>
            </div>
            <div class="card-body">
                <form asp-action="AdicionarAula" method="post">
                    <input type="hidden" name="CursoId" value="@Model.CursoId">

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
                            <input name="Nome" type="text" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-primary text-uppercase small">Duração (min)</label>
                            <input name="DuracaoEmMinutos" type="number" class="form-control" min="0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold text-primary text-uppercase small">Ordem</label>
                            <input name="Ordem" type="number" class="form-control" min="1">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary rounded-pill px-4 w-100" type="submit">Adicionar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Aulas.Count == 0)
        {
            <div class="alert alert-primary border-start border-primary border-4 rounded-3 mt-3" role="alert">
                Nenhuma aula cadastrada neste curso.
            </div>
        }
        else
        {
            <div class="mt-3">
                @foreach (ListarAulaViewModel aula in Model.Aulas)
                {
                    <div class="card border-primary-subtle shadow-sm mb-2">
                        <div class="card-body py-3">
                            <div class="row align-items-center g-3">
                                <div class="col-md-1">
                                    <span class="badge text-bg-primary rounded-pill">@aula.Ordem</span>
                                </div>
                                <div class="col-md-4">
                                    <strong>@aula.Nome</strong>
                                </div>
                                <div class="col-md-2 text-secondary small">
                                    @aula.DuracaoEmMinutos min
                                </div>
                                <div class="col-md-5">
                                    <div class="d-flex justify-content-end gap-2">
                                        <form asp-action="RemoverAula" method="post" class="d-inline">
                                            <input type="hidden" name="Id" value="@aula.Id">
                                            <input type="hidden" name="CursoId" value="@Model.CursoId">
                                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" type="submit">Remover</button>
                                        </form>
                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#editarAula_@aula.Id.ToString("N")"
                                                aria-expanded="false">
                                            Editar
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="collapse mt-3" id="editarAula_@aula.Id.ToString("N")">
                                <hr class="border-primary-subtle">
                                <form asp-action="EditarAula" method="post">
                                    <input type="hidden" name="Id" value="@aula.Id">
                                    <input type="hidden" name="CursoId" value="@Model.CursoId">

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
                                            <input name="Nome" type="text" class="form-control" value="@aula.Nome">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold text-primary text-uppercase small">Duração (min)</label>
                                            <input name="DuracaoEmMinutos" type="number" class="form-control" min="0" value="@aula.DuracaoEmMinutos">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label fw-semibold text-primary text-uppercase small">Ordem</label>
                                            <input name="Ordem" type="number" class="form-control" min="1" value="@aula.Ordem">
                                        </div>
                                        <div class="col-md-2 d-flex align-items-end">
                                            <button class="btn btn-primary rounded-pill px-4 w-100" type="submit">Salvar</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
