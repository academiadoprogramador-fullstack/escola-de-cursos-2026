@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Curso";
}

@model CadastrarCursoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Cadastrar" method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control">
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nivel" class="form-label fw-semibold text-primary text-uppercase small">Nível</label>
        <select asp-for="Nivel" class="form-select" asp-items="Html.GetEnumSelectList<NivelCurso>()">
            <option value="">Selecione o nível...</option>
        </select>
        <span asp-validation-for="Nivel" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CargaHoraria" class="form-label fw-semibold text-primary text-uppercase small">Carga Horária (horas)</label>
        <input asp-for="CargaHoraria" type="number" class="form-control" min="2" max="100">
        <span asp-validation-for="CargaHoraria" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label fw-semibold text-primary text-uppercase small">Categoria</label>
        <select asp-for="CategoriaId" class="form-select" asp-items="@(ViewBag.Categorias as List<SelectListItem>)">
            <option value="">Selecione uma categoria...</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger small fw-semibold"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
